{
  "schemaVersion": 1,
  "id": "ericvrp.menu-icon",
  "name": "Omarchy Menu Icon",
  "version": "0.1.0",
  "author": "Eric van Riet Paap",
  "license": "MIT",
  "description": "A customizable Omarchy menu button with text, emoji, and cached image support.",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Menu.qml",
    "barWidget": "BarWidget.qml"
  },
  "omarchy": {
    "clonedFrom": "omarchy.menu"
  },
  "barWidget": {
    "displayName": "Omarchy Menu Icon",
    "description": "Customize the Omarchy menu button with text, emoji, or an HTTPS image.",
    "category": "Compositor",
    "defaultSection": "left",
    "allowMultiple": false,
    "defaults": {
      "text": ""
    },
    "schema": [
      {
        "key": "text",
        "type": "string",
        "label": "Text or HTTPS image URL"
      }
    ]
  }
}
